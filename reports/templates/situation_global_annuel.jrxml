	<parameter name="matricule" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT matricule, nom_ad, prenom_ad,sum(total_annuel)::bigint as total_annuel, annee
	FROM public.v_reglement_globale
		where annee =   $P{matricule}  
	group by matricule, nom_ad, prenom_ad,annee
	order by total_annuel DESC;]]>
	</queryString>
