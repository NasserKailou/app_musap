	<parameter name="date1" class="java.sql.Timestamp"/>
	<parameter name="date2" class="java.sql.Timestamp"/>
	<queryString language="SQL">
		<![CDATA[SELECT id, nom_ad, prenom_ad,code_carnet,is_remboursement, id_adherent, matricule, ref_facture, montant_reglement, structure, date_payement, who_done, when_done, on_deleted
	FROM public.v_reglement
	where is_remboursement is true and  CAST(when_done AS DATE) between CAST($P{date1} AS DATE)   and  CAST($P{date2} AS DATE)  and montant_reglement >0
	order by matricule ASC;]]>
	</queryString>
