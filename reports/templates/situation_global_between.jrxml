	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="muaposte\MSAP.xml"/>
	<parameter name="date1" class="java.sql.Timestamp"/>
	<parameter name="date2" class="java.sql.Timestamp"/>
	<queryString language="SQL">
		<![CDATA[SELECT matricule, nom_ad, prenom_ad,when_done,code_carnet,sum(total_annuel)::bigint as total_annuel, annee
	FROM public.v_reglement_globale
		where CAST(when_done AS DATE) between CAST($P{date1} AS DATE)   and  CAST($P{date2} AS DATE) 
	group by matricule, nom_ad, prenom_ad,annee,when_done,code_carnet
	order by total_annuel DESC;]]>
	</queryString>
