<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="badge_principale_ay" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="243" columnSpacing="16" columnCount="2" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

	<parameter name="logoGauchePath" class="java.lang.String">
		<defaultValueExpression><![CDATA[new java.io.File("").getAbsolutePath() + "/public/images/logo.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="logoDroitePath" class="java.lang.String">
		<defaultValueExpression><![CDATA[new java.io.File("").getAbsolutePath() + "/public/images/logo.png"]]></defaultValueExpression>
	</parameter>

	<queryString>
		<![CDATA[
SELECT ay.id, ay.nom_ay, ay.lien, ay.genre, ay.date_naiss, ay.picture,
       date_part('year', age(now(), ay.date_naiss)) AS age,
       ad.matricule AS matricule_assure, ad.nom_ad, ad.prenom_ad
FROM public.ayant_droit ay
JOIN public.adherent ad ON ad.id = ay.adherent
WHERE ay.is_ok_for_printing IS TRUE AND ay.on_deleted IS FALSE
ORDER BY ad.nom_ad, ay.nom_ay
		]]>
	</queryString>

	<field name="id" class="java.lang.Long"/>
	<field name="nom_ay" class="java.lang.String"/>
	<field name="lien" class="java.lang.String"/>
	<field name="genre" class="java.lang.String"/>
	<field name="date_naiss" class="java.sql.Timestamp"/>
	<field name="picture" class="java.lang.String"/>
	<field name="age" class="java.lang.Double"/>
	<field name="matricule_assure" class="java.lang.String"/>
	<field name="nom_ad" class="java.lang.String"/>
	<field name="prenom_ad" class="java.lang.String"/>

	<background>
		<band splitType="Stretch"/>
	</background>

	<detail>
		<band height="153" splitType="Stretch">

			<rectangle>
				<reportElement x="0" y="0" width="243" height="153" mode="Opaque" backcolor="#FFFFFF"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#999999"/>
				</graphicElement>
			</rectangle>

			<rectangle>
				<reportElement x="0" y="0" width="13" height="153" mode="Opaque" backcolor="#DDDDDD"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="0" y="0" width="13" height="153"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left">
					<font size="7" isBold="false"/>
				</textElement>
				<text><![CDATA[Carte d'accès MAINS]]></text>
			</staticText>

			<image onErrorType="Blank">
				<reportElement x="16" y="2" width="18" height="18"/>
				<imageExpression><![CDATA[$P{logoGauchePath}]]></imageExpression>
			</image>
			<image onErrorType="Blank">
				<reportElement x="207" y="2" width="18" height="18"/>
				<imageExpression><![CDATA[$P{logoDroitePath}]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="36" y="2" width="169" height="7"/>
				<textElement textAlignment="Center"><font size="5" isBold="true"/></textElement>
				<text><![CDATA[REPUBLIQUE DU NIGER]]></text>
			</staticText>
			<staticText>
				<reportElement x="36" y="9" width="169" height="6"/>
				<textElement textAlignment="Center"><font size="4.5"/></textElement>
				<text><![CDATA[Ministère de l'Economie et des Finances]]></text>
			</staticText>
			<staticText>
				<reportElement x="36" y="15" width="169" height="6"/>
				<textElement textAlignment="Center"><font size="4.5"/></textElement>
				<text><![CDATA[Institut National de la Statistique]]></text>
			</staticText>

			<line>
				<reportElement x="15" y="23" width="226" height="1"/>
			</line>

			<image onErrorType="Blank">
				<reportElement x="16" y="27" width="56" height="66"/>
				<imageExpression><![CDATA[(new java.io.File($F{picture} == null ? "" : $F{picture}).exists() ? $F{picture} : new java.io.File("").getAbsolutePath() + "/public/images/logo.png")]]></imageExpression>
			</image>

			<staticText>
				<reportElement x="76" y="27" width="150" height="10"/>
				<textElement><font size="7" isBold="true" isUnderline="true"/></textElement>
				<text><![CDATA[Bénéficiaire]]></text>
			</staticText>

			<staticText>
				<reportElement x="76" y="39" width="55" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<text><![CDATA[Prénom :]]></text>
			</staticText>
			<textField>
				<reportElement x="131" y="39" width="59" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{nom_ay}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="76" y="50" width="55" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<text><![CDATA[Lien :]]></text>
			</staticText>
			<textField>
				<reportElement x="131" y="50" width="59" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{lien}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="76" y="61" width="55" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<text><![CDATA[Né(e) le :]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="131" y="61" width="59" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{date_naiss}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="76" y="72" width="55" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<text><![CDATA[Age :]]></text>
			</staticText>
			<textField>
				<reportElement x="131" y="72" width="59" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{age}.intValue() + " ans"]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="76" y="88" width="58" height="10"/>
				<textElement><font size="6.5" isBold="true"/></textElement>
				<text><![CDATA[N° Assuré(e) :]]></text>
			</staticText>
			<textField>
				<reportElement x="134" y="88" width="56" height="10"/>
				<textElement><font size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{matricule_assure}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="134" y="97" width="56" height="1" forecolor="#CC0000"/>
			</line>

			<staticText>
				<reportElement x="76" y="99" width="55" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<text><![CDATA[Prénom :]]></text>
			</staticText>
			<textField>
				<reportElement x="131" y="99" width="59" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{prenom_ad}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="76" y="110" width="55" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<text><![CDATA[Nom :]]></text>
			</staticText>
			<textField>
				<reportElement x="131" y="110" width="59" height="10"/>
				<textElement><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{nom_ad}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="16" y="98" width="56" height="8"/>
				<textElement textAlignment="Center"><font size="6" isItalic="true"/></textElement>
				<text><![CDATA[Le Président]]></text>
			</staticText>
			<line>
				<reportElement x="18" y="112" width="52" height="1"/>
			</line>
			<staticText>
				<reportElement x="16" y="113" width="56" height="7"/>
				<textElement textAlignment="Center"><font size="5"/></textElement>
				<text><![CDATA[MAINS]]></text>
			</staticText>

			<componentElement>
				<reportElement x="194" y="88" width="32" height="32"/>
				<c:QRCode xmlns:c="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
					<c:codeExpression><![CDATA["MAINS|" + $F{matricule_assure} + "|" + $F{nom_ay}]]></c:codeExpression>
				</c:QRCode>
			</componentElement>

			<line>
				<reportElement x="13" y="144" width="230" height="1"/>
			</line>
			<textField>
				<reportElement x="13" y="145" width="230" height="8"/>
				<textElement textAlignment="Center"><font size="5.5"/></textElement>
				<textFieldExpression><![CDATA["Validité deux (2) ans du 01/01/" + new java.text.SimpleDateFormat("yyyy").format(new java.util.Date()) + " au 31/12/" + (Integer.parseInt(new java.text.SimpleDateFormat("yyyy").format(new java.util.Date())) + 1)]]></textFieldExpression>
			</textField>

		</band>
	</detail>

	<noData>
		<band height="60">
			<staticText>
				<reportElement x="0" y="0" width="243" height="60"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="10"/></textElement>
				<text><![CDATA[Aucun ayant droit éligible à l'impression (photo non insérée).]]></text>
			</staticText>
		</band>
	</noData>

</jasperReport>
