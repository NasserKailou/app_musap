	<summary>
		<band height="115" splitType="Stretch">
			<textField>
				<reportElement x="292" y="0" width="88" height="20" uuid="6d5128b2-9b11-4a8c-a2a7-880cc78badd8"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[new DecimalFormat("##,###.###",new DecimalFormatSymbols(Locale.FRENCH)).format($V{montant1})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="0" width="292" height="20" uuid="24e93475-9fb5-47b6-9668-3525bf10dec1"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Montant TOTAL du BON (100%) :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="292" y="20" width="88" height="20" uuid="7e56c2ee-7394-4327-b78a-79b10292c2f2"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[new DecimalFormat("##,###.###", new DecimalFormatSymbols(Locale.FRENCH))
    .format(
        ($V{montant1}.doubleValue()) 
        * 
        ($F{taux_effectif}.doubleValue() / 100.0)
    )
]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="292" y="40" width="88" height="20" uuid="1aad60b7-f37f-40a7-a5ee-2bdac90cc02a"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[new DecimalFormat("##,###.###", new DecimalFormatSymbols(Locale.FRENCH))
    .format(
        ($V{montant1}.doubleValue()) 
        * 
         (100  - ($F{taux_effectif} == null ? 0 : $F{taux_effectif}.intValue()))/ 100.0)
    
]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="20" width="292" height="20" uuid="e3623212-f0b1-44b0-8676-99ff03104f96"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Montant TOTAL couvert par la mutuelle à : "+$F{taux_effectif}+" %"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="40" width="292" height="20" uuid="0371d4b2-8916-49a0-b29f-dfdd210fbfa0"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Montant TOTAL à la charge de l'adhérent : " 
+ (100 
   - ($F{taux_effectif} == null ? 0 : $F{taux_effectif}.intValue())
  )
+ " %"
]]></textFieldExpression>
			</textField>
			<componentElement>
				<reportElement x="290" y="62" width="89" height="53" uuid="d29cdd04-f805-46d2-a003-8fc38e3d094b"/>
